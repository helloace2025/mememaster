# =============================================================================
# MemeMaster — Environment Template
# Copy to .env and fill what you have. Never commit .env.
# =============================================================================

# -----------------------------------------------------------------------------
# GMGN
# -----------------------------------------------------------------------------
GMGN_API_KEY=
GMGN_OPENAPI_BASE=https://openapi.gmgn.ai
GMGN_API_BASE=https://gmgn.ai/defi/quotation/v1
GMGN_DEFAULT_CHAIN=sol

# -----------------------------------------------------------------------------
# 6551 / OpenNews (Twitter)
# -----------------------------------------------------------------------------
OPENNEWS_TOKEN=
OPENNEWS_API_BASE=https://ai.6551.io
OPENNEWS_WS_BASE=wss://ai.6551.io/open/twitter_wss

# -----------------------------------------------------------------------------
# Backup market data
# -----------------------------------------------------------------------------
DEXSCREENER_API_BASE=https://api.dexscreener.com

# =============================================================================
# LLM — multi provider (fill any; switch with LLM_PROVIDER)
# =============================================================================
# active: auto | deepseek | openai | google | anthropic | qwen | moonshot |
#         zhipu | siliconflow | doubao | xai | openrouter | groq | minimax |
#         yi | baichuan | custom
LLM_PROVIDER=auto

# auto 探测顺序（从左到右，第一个有 Key 的生效）
LLM_PROVIDER_PRIORITY=deepseek,openai,google,anthropic,qwen,moonshot,zhipu,siliconflow,doubao,xai,openrouter,groq,minimax,yi,baichuan,custom

# 可选：全局覆盖模型名（不填则用各厂商默认 / 各自 *_MODEL）
LLM_MODEL=

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# --- Anthropic Claude ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Google Gemini (OpenAI-compatible endpoint) ---
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.6-flash

# --- DeepSeek（经济首选 deepseek-v4-flash；chat/reasoner 将下线）---
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# --- xAI Grok ---
XAI_API_KEY=
XAI_MODEL=grok-4.5

# --- 月之暗面 Kimi（优先 kimi-k2.6 / kimi-k3；moonshot-v1 将下线）---
MOONSHOT_API_KEY=
MOONSHOT_MODEL=kimi-k2.6

# --- 通义千问（DashScope 兼容模式 Key）---
QWEN_API_KEY=
QWEN_MODEL=qwen-plus-latest

# --- 智谱 GLM ---
ZHIPU_API_KEY=
ZHIPU_MODEL=glm-4.6

# --- 硅基流动 ---
SILICONFLOW_API_KEY=
SILICONFLOW_MODEL=deepseek-ai/DeepSeek-V4-Flash

# --- 豆包 / 火山方舟（ARK_API_KEY；MODEL 请改成你的接入点 id）---
DOUBAO_API_KEY=
DOUBAO_MODEL=doubao-pro-32k

# --- MiniMax ---
MINIMAX_API_KEY=
MINIMAX_MODEL=abab6.5s-chat

# --- 百川 ---
BAICHUAN_API_KEY=
BAICHUAN_MODEL=Baichuan4-Turbo

# --- 零一万物 Yi ---
YI_API_KEY=
YI_MODEL=yi-lightning

# --- Groq ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- OpenRouter（聚合）---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-chat

# --- 自定义 OpenAI 兼容网关 ---
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_MODEL=

# -----------------------------------------------------------------------------
# Hot panel
# -----------------------------------------------------------------------------
HOT_INTERVAL=24h
HOT_LIMIT_PER_CHAIN=15
HOT_CHAINS=sol,bsc,base,eth,robinhood
# Frontend origins allowed to call API (comma-separated). Railway: set to your FE URL or *
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# PORT is injected by Railway; local default 8000
# PORT=8000
